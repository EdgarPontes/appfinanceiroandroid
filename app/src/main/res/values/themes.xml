<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Tokens de cor definidos em values/colors.xml e values-night/colors.xml -->

    <!-- Tema base compartilhado entre claro e escuro (Material 3 DayNight) -->
    <style name="Theme.Appfinanceiro.Base" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Marca -->
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <item name="colorPrimaryContainer">@color/surface_variant</item>
        <item name="colorOnPrimaryContainer">@color/on_surface</item>

        <!-- Secundária -->
        <item name="colorSecondary">@color/brand_secondary</item>
        <item name="colorOnSecondary">@color/on_brand</item>
        <item name="colorSecondaryContainer">@color/surface_variant</item>
        <item name="colorOnSecondaryContainer">@color/on_surface</item>

        <!-- CTA -->
        <item name="colorTertiary">@color/cta_primary</item>
        <item name="colorOnTertiary">@color/on_cta</item>

        <!-- Superfícies -->
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorSurfaceContainer">@color/surface_variant</item>
        <item name="colorSurfaceContainerHigh">@color/surface_elevated</item>

        <!-- Fundo -->
        <item name="android:windowBackground">@color/background</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>

        <!-- Erro -->
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>

        <!-- Bordas -->
        <item name="colorOutline">@color/outline</item>
        <item name="colorOutlineVariant">@color/outline</item>

        <!-- Barras do sistema -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@color/surface</item>
    </style>

    <!-- Tema claro (variante diurna do DayNight) -->
    <style name="Theme.Appfinanceiro" parent="Theme.Appfinanceiro.Base">
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>

    <!-- Tema para componentes Glass -->
    <style name="Theme.Appfinanceiro.Glass">
        <item name="android:background">?attr/colorSurface</item>
        <item name="android:foreground">@android:color/transparent</item>
    </style>

    <!-- Estilo para Cards de Vidro -->
    <style name="GlassCard">
        <item name="android:background">@drawable/glass_card_background</item>
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="strokeColor">?attr/colorOutline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <!-- Estilo para Botões com Glassmorphism -->
    <style name="GlassButton" parent="Widget.Material3.Button">
        <item name="android:background">@drawable/glass_button_background</item>
        <item name="backgroundTint">@null</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:elevation">4dp</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <!-- Estilo para TextInput com Glassmorphism -->
    <style name="GlassTextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">?attr/colorSurface</item>
        <item name="boxStrokeColor">?attr/colorPrimary</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

</resources>
