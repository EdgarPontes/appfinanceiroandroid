<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/ModernCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardElevation="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/notification_edit_title"
            android:textColor="?attr/colorOnSurface"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/notification_edit_desc"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13sp" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/ModernTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:hint="@string/notification_field_title">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/configTitleEditText"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:inputType="textCapSentences"
                android:maxLength="255"
                android:singleLine="true"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            style="@style/ModernTextInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:hint="@string/notification_field_text">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/configTextEditText"
                android:layout_width="match_parent"
                android:layout_height="104dp"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLength="1000"
                android:minLines="3"
                android:textColor="?attr/colorOnSurface" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notification_field_priority"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <Spinner
            android:id="@+id/configPrioritySpinner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="4dp"
            android:background="@drawable/bg_spinner_selector"
            android:paddingStart="16dp"
            android:paddingEnd="44dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/notification_placeholders"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Spinner
                android:id="@+id/placeholderSpinner"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_selector"
                android:paddingStart="16dp"
                android:paddingEnd="44dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/insertPlaceholderButton"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="0dp"
                android:paddingHorizontal="14dp"
                android:text="@string/notification_insert"
                android:textAllCaps="false"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                app:cornerRadius="12dp"
                app:strokeColor="?attr/colorPrimary" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/cancelConfigButton"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/history_cancel"
                android:textAllCaps="false"
                android:textColor="?attr/colorOnSurfaceVariant" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/saveConfigButton"
                style="@style/PrimaryCTAButton"
                android:layout_width="wrap_content"
                android:layout_height="52dp"
                android:layout_marginStart="8dp"
                android:text="@string/notification_save_changes" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
