<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_edit_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/notification_edit_desc"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_field_title" />

    <EditText
        android:id="@+id/configTitleEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/notification_field_title_hint"
        android:inputType="textCapSentences"
        android:maxLength="255"
        android:singleLine="true" />

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_field_text" />

    <EditText
        android:id="@+id/configTextEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:hint="@string/notification_field_text_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="1000"
        android:minLines="3" />

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_field_priority" />

    <Spinner
        android:id="@+id/configPrioritySpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/glass_button_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_placeholders" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <Spinner
            android:id="@+id/placeholderSpinner"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:background="@drawable/glass_button_background"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/insertPlaceholderButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:minWidth="0dp"
            android:text="@string/notification_insert"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelConfigButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveConfigButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/notification_save_changes" />
    </LinearLayout>
</LinearLayout>
