<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingTop="8dp"
    android:paddingEnd="24dp"
    android:paddingBottom="4dp">

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/inviteEmailLayout"
        style="@style/ModernTextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="E-mail do convidado">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/inviteEmailEditText"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:inputType="textEmailAddress"
            android:maxLength="255"
            android:singleLine="true"
            android:textColor="?attr/colorOnSurface" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:text="Como deseja enviar o convite?"
        android:textColor="?attr/colorOnSurface"
        android:textSize="14sp"
        android:textStyle="bold" />

    <RadioGroup
        android:id="@+id/inviteChannelGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="vertical">

        <RadioButton
            android:id="@+id/inviteChannelEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="E-mail" />

        <RadioButton
            android:id="@+id/inviteChannelWhatsapp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="WhatsApp" />

        <RadioButton
            android:id="@+id/inviteChannelPush"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Notificação push" />
    </RadioGroup>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="O código de confirmação sempre será enviado para o e-mail informado. No push, a pessoa precisa ter o app instalado e notificações ativas."
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="12sp" />
</LinearLayout>
