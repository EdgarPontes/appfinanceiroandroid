<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Card padrão das telas de configurações e notificações -->
    <style name="SettingsCard">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
        <item name="strokeColor">#14000000</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="SettingsSectionTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@android:color/black</item>
    </style>

    <style name="SettingsLabel">
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="SettingsHelper">
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textColor">@android:color/darker_gray</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="SettingsIcon">
        <item name="android:layout_width">22dp</item>
        <item name="android:layout_height">22dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:contentDescription">@null</item>
        <item name="android:tint">@color/primary_purple</item>
    </style>

</resources>
