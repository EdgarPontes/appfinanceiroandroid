<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_create_title"
        android:textColor="?attr/colorOnSurface"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/notification_create_desc"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="13sp" />

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_field_title" />

    <EditText
        android:id="@+id/reminderTitleEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/notification_field_title_hint"
        android:inputType="textCapSentences"
        android:maxLength="255"
        android:singleLine="true" />

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_field_text" />

    <EditText
        android:id="@+id/reminderTextEditText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top|start"
        android:hint="@string/notification_field_text_hint"
        android:inputType="textCapSentences|textMultiLine"
        android:maxLength="1000"
        android:minLines="2" />

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_field_date" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/reminderDateTextView"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:hint="@string/notification_field_date_hint"
            android:paddingVertical="12dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp" />

        <ImageButton
            android:id="@+id/reminderDateButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/notification_field_date"
            android:padding="10dp"
            android:src="@drawable/ic_month_calendar"
            app:tint="?attr/colorPrimary" />
    </LinearLayout>

    <TextView
        style="@style/SettingsLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/notification_field_recurrence" />

    <Spinner
        android:id="@+id/reminderRecurrenceSpinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@drawable/glass_button_background"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="end"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/cancelReminderButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/history_cancel" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveReminderButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/notification_save" />
    </LinearLayout>
</LinearLayout>
