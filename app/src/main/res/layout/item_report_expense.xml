<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_outlined_rounded"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <TextView
        android:id="@+id/reportExpenseDateTextView"
        android:layout_width="64dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_period_selector"
        android:gravity="center"
        android:padding="4dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="10sp"
        tools:text="24/10/2026" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reportExpenseDescriptionTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="Compras no supermercado" />

        <TextView
            android:id="@+id/reportExpenseCategoryTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="11sp"
            tools:text="Alimentação" />
    </LinearLayout>

    <TextView
        android:id="@+id/reportExpenseAmountTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:textColor="@color/money_negative"
        android:textSize="14sp"
        android:textStyle="bold"
        tools:text="R$ 189,90" />
</LinearLayout>
