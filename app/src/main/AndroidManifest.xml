<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".AppFinanceiroApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Appfinanceiro"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Appfinanceiro">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Activities da aplicação -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:label="Login"
            android:theme="@style/Theme.Appfinanceiro"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.dashboard.DashboardActivity"
            android:exported="false"
            android:label="Dashboard"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.transactions.TransactionsActivity"
            android:exported="false"
            android:label="Transações"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.cards.CardsActivity"
            android:exported="false"
            android:label="Cartões"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.accounts.AccountsActivity"
            android:exported="false"
            android:label="Contas"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.accounts.StatementImportActivity"
            android:exported="false"
            android:label="Importar extrato"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false"
            android:label="Perfil"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="Configurações"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.categories.CategoriesActivity"
            android:exported="false"
            android:label="Categorias"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.reports.ReportsActivity"
            android:exported="false"
            android:label="Relatórios"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.notifications.NotificationsActivity"
            android:exported="false"
            android:label="Notificações"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.notifications.NotificationHistoryActivity"
            android:exported="false"
            android:label="Histórico de Notificações"
            android:parentActivityName=".ui.dashboard.DashboardActivity"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.menu.MenuActivity"
            android:exported="false"
            android:label="Menu"
            android:theme="@style/Theme.Appfinanceiro" />

        <activity
            android:name=".ui.menu.FeatureDestinationActivity"
            android:exported="false"
            android:label="AppFinanceiro"
            android:theme="@style/Theme.Appfinanceiro" />

        <receiver
            android:name=".notifications.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
